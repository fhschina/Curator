{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "same_duplicate_group",
    "a_can_replace_b",
    "b_can_replace_a",
    "relation_type",
    "material_difference",
    "fuzzy_scope",
    "confidence",
    "reason_codes",
    "evidence"
  ],
  "properties": {
    "same_duplicate_group": {"type": "string", "enum": ["YES", "NO", "UNRESOLVED"]},
    "a_can_replace_b": {"type": "string", "enum": ["YES", "NO", "UNRESOLVED"]},
    "b_can_replace_a": {"type": "string", "enum": ["YES", "NO", "UNRESOLVED"]},
    "relation_type": {
      "type": "string",
      "enum": ["EXACT", "CANONICAL_EXACT", "NEAR_SURFACE", "CONTAINMENT", "VERSION_RELATED", "RELATED_NON_DUPLICATE", "UNRELATED", "UNRESOLVED"]
    },
    "material_difference": {"type": "string", "enum": ["NONE", "MINOR", "MAJOR", "UNRESOLVED"]},
    "fuzzy_scope": {"type": "string", "enum": ["IN_SCOPE", "BORDERLINE", "OUT_OF_SCOPE", "UNRESOLVED"]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["NUMBER_CHANGE", "DATE_TIME_CHANGE", "PRODUCT_VERSION_CHANGE", "URL_CHANGE", "NAMED_ENTITY_CHANGE", "NEGATION_CHANGE", "CODE_LITERAL_CHANGE", "CODE_OUTPUT_CHANGE", "INSERTION_DELETION", "BOILERPLATE", "PARSER_NOISE", "LANGUAGE_MISMATCH", "TOPIC_ONLY", "INSUFFICIENT_EVIDENCE", "OTHER_MATERIAL"]
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["side", "start_char", "end_char", "quote"],
        "properties": {
          "side": {"type": "string", "enum": ["A", "B"]},
          "start_char": {"type": "integer", "minimum": 0},
          "end_char": {"type": "integer", "minimum": 0},
          "quote": {"type": "string", "maxLength": 240}
        }
      }
    }
  }
}
